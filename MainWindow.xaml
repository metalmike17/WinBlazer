<Window x:Class="PCOptimizer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinBlazer" Width="1100" Height="720" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource NavyBrush}"
        TextElement.Foreground="{DynamicResource TextBrush}" FontFamily="Segoe UI">
  <Grid x:Name="Root" Background="{DynamicResource NavyBrush}">
    <!-- Soft color glows behind translucent panels give the glass look. -->
    <Canvas IsHitTestVisible="False" ClipToBounds="True">
      <Ellipse Width="520" Height="520" Canvas.Left="-160" Canvas.Top="-200">
        <Ellipse.Fill><RadialGradientBrush><GradientStop Color="#5500D4FF" Offset="0"/><GradientStop Color="#0000D4FF" Offset="1"/></RadialGradientBrush></Ellipse.Fill>
      </Ellipse>
      <Ellipse Width="700" Height="700" Canvas.Right="-250" Canvas.Bottom="-320">
        <Ellipse.Fill><RadialGradientBrush><GradientStop Color="#667C3AED" Offset="0"/><GradientStop Color="#007C3AED" Offset="1"/></RadialGradientBrush></Ellipse.Fill>
      </Ellipse>
    </Canvas>
    <Grid Margin="14">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="220"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Border Style="{StaticResource GlassCard}" Padding="12">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="WINBLAZER" FontSize="18" FontWeight="Bold"
                     Foreground="{DynamicResource AccentBrush}" Margin="10,8,0,20"/>
          <DockPanel DockPanel.Dock="Top" Margin="2,-10,2,10">
            <Button x:Name="ThemeButton" DockPanel.Dock="Right" Margin="6,0,0,0" Padding="9,4" FontSize="12"
                    FontFamily="Segoe MDL2 Assets" Content="&#xE706;" ToolTip="Light or dark theme (Ctrl+T)"
                    AutomationProperties.Name="Switch light or dark theme"/>
            <Button x:Name="SearchButton" Content="Search   Ctrl+K" Margin="0" Padding="8,4" FontSize="12"/>
          </DockPanel>
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="Sidebar"/>
          </ScrollViewer>
        </DockPanel>
      </Border>
      <ContentControl x:Name="PageHost" Grid.Column="1" Margin="22,6,0,0" Focusable="False">
        <ContentControl.RenderTransform><TranslateTransform/></ContentControl.RenderTransform>
      </ContentControl>
    </Grid>
  </Grid>
</Window>
